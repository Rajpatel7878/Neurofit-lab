# NeuroFit Labs — Environment Variables
# Copy this file to .env.local and fill in your values
# The app runs in demo mode without these — no config required!

# ─── Supabase (enables real auth & database) ────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# ─── Stripe (enables real checkout) ─────────────────────────────────────────
# Get these from https://dashboard.stripe.com/products
NEXT_PUBLIC_STRIPE_PRODUCT_EEG=price_xxx
NEXT_PUBLIC_STRIPE_PRODUCT_SUB=price_xxx
NEXT_PUBLIC_STRIPE_PRODUCT_BUNDLE=price_xxx

# Secret key — never expose to the client
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
